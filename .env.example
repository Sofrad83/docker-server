# ─────────────────────────────────────────────────────────────────────────────
#  docker-server — réglages du poste (tous optionnels).
#  Copiez ce fichier en « .env » pour les modifier, puis relancez start.
# ─────────────────────────────────────────────────────────────────────────────

# Ports du proxy. Si 80 / 443 sont déjà pris (IIS, Skype, WAMP…), start les
# remplace automatiquement par 8080 / 8443.
HTTP_PORT=80
HTTPS_PORT=443

# Serveur MySQL créé au premier démarrage (port sur votre machine et version).
# Version : 5.6, 5.7, 8.0, 8.4 — ou mariadb:10.6, mariadb:11.4… Modifiable ensuite
# depuis le tableau de bord.
MYSQL_PORT=3306
MYSQL_VERSION=5.7

# FTP : port de connexion et plage de ports passifs.
FTP_PORT=21
FTP_PASV_MIN=30000
FTP_PASV_MAX=30009

# Fuseau horaire de PHP et des serveurs.
TZ=Europe/Paris

# Adresse d'écoute. 127.0.0.1 = accessible uniquement depuis ce poste (recommandé).
BIND_IP=127.0.0.1
